<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AWX Infrastructure Automation</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
        }

        /* HEADER */

        .header {
            background: #111827;
            color: white;
            padding: 45px 20px;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            font-size: 40px;
        }

        .header p {
            margin-top: 12px;
            font-size: 18px;
            color: #d1d5db;
        }

        /* MAIN */

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* STATUS */

        .status-card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 25px;
            text-align: center;
        }

        .status {
            display: inline-block;
            padding: 10px 18px;
            border-radius: 25px;
            background: #dcfce7;
            color: #166534;
            font-weight: bold;
            font-size: 15px;
        }

        .status-card h2 {
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .status-card p {
            color: #6b7280;
        }

        /* CARDS */

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 25px;
        }

        .card h2 {
            margin-top: 0;
        }

        /* INFRASTRUCTURE GRID */

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-top: 20px;
        }

        .item {
            padding: 22px;
            background: #f9fafb;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
        }

        .item strong {
            display: block;
            margin-bottom: 10px;
            color: #6b7280;
            font-size: 14px;
        }

        .value {
            font-size: 18px;
            font-weight: bold;
            word-break: break-word;
        }

        /* PIPELINE */

        .pipeline {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 25px;
        }

        .pipeline-step {
            background: #111827;
            color: white;
            padding: 15px 20px;
            border-radius: 8px;
            font-weight: bold;
        }

        .arrow {
            font-size: 22px;
            font-weight: bold;
            color: #6b7280;
        }

        /* DEPLOYMENT HISTORY */

        .history {
            margin-top: 20px;
        }

        .history-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 20px;
            border-bottom: 1px solid #e5e7eb;
        }

        .history-item:last-child {
            border-bottom: none;
        }

        .history-left strong {
            display: block;
            margin-bottom: 5px;
        }

        .history-left span {
            color: #6b7280;
            font-size: 14px;
        }

        .success {
            background: #dcfce7;
            color: #166534;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        /* IAC */

        .iac {
            background: #f9fafb;
            padding: 22px;
            border-radius: 10px;
            border-left: 5px solid #111827;
            line-height: 1.7;
        }

        /* FOOTER */

        .footer {
            text-align: center;
            padding: 35px 20px;
            color: #6b7280;
            font-size: 14px;
        }

        /* MOBILE */

        @media (max-width: 800px) {

            .grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .pipeline {
                flex-direction: column;
            }

            .arrow {
                transform: rotate(90deg);
            }
        }

        @media (max-width: 550px) {

            .grid {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 30px;
            }

            .history-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
        }

    </style>
</head>

<body>

<!-- HEADER -->

<div class="header">

    <h1>AWX Infrastructure Automation</h1>

    <p>
        Infrastructure deployed automatically using Ansible
    </p>

</div>


<div class="container">

    <!-- DEMO INFORMATION -->

    <div class="card">

        <h2>AWX Deployment Information</h2>

        <p>
            <strong>Target:</strong>
            {{ ansible_hostname }}
        </p>

        <p>
            <strong>Platform:</strong>
            {{ ansible_distribution }}
            {{ ansible_distribution_version }}
        </p>

        <p>
            <strong>Automation:</strong>
            Ansible via AWX
        </p>

        <p>
            <strong>Configuration:</strong>
            Git-managed infrastructure
        </p>

    </div>

</div>


<!-- FOOTER -->

<div class="footer">

    AWX Infrastructure Automation Demo

    <br>

    Managed automatically with Ansible

    <br><br>

    Deployment ID:
    {{ deployment_id }}

</div>

</body>
</html>
